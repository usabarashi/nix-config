{
  "mcpServers": {
    "voicevox": {
      "command": "voicevox-mcp-server",
      "args": [],
      "timeout": 120
    },
    "library": {
      "url": "https://library-mcp.usabarashi.net/mcp",
      "timeout": 120
    },
    "chrome-devtools": {
      "command": "chrome-devtools-mcp",
      "args": [
        "--isolated",
        "--headless",
        "--channel=stable",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "timeout": 120
    }
  }
}
