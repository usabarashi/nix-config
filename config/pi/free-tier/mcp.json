{
  "mcpServers": {
    "chrome-devtools": {
      "command": "chrome-devtools-mcp",
      "args": [
        "--isolated",
        "--headless",
        "--channel=stable",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--chrome-arg=--no-sandbox",
        "--chrome-arg=--disable-setuid-sandbox"
      ],
      "timeout": 120
    }
  }
}
